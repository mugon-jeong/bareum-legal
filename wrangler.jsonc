{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bareum-legal",
  "account_id": "ea8c6ae2f1699d17801ddf25e382e4b0",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./_site",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "bareum.app", "custom_domain": true },
    { "pattern": "www.bareum.app", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
